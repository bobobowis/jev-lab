# Copy to .env at the repo root. The npm scripts load it for every task (the jev command does not).
# Live Jev: either key. TypeSafe takes precedence. Levels 1 to 5 run offline on the mock without one;
# levels 6 to 10 need one.
OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=

# Optional: the model per agent for levels 6 to 10. Names differ per agent, so set the one you use.
# pi's default is openrouter/google/gemini-3.8-flash (needs OPENROUTER_API_KEY); with an OpenAI login
# in pi, for example openai/gpt-6.1-sol. Claude Code's default is claude-haiku-5-5; Codex uses your
# account's default. JEV_AGENT_MODEL sets all three at once.
# JEV_AGENT_MODEL_PI=
# JEV_AGENT_MODEL_CLAUDE=
# JEV_AGENT_MODEL_CODEX=

# Optional: which agent a session uses when the page doesn't pick one: pi, claude, or codex.
# JEV_AGENT=

# Optional: extra variable names the agent may see, comma separated. By default it sees only the
# shell basics, the Jev keys, its own credentials, and JEV_* settings.
# JEV_AGENT_ENV=
